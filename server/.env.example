# Copy to .env and replace every CHANGE_ME value.
POSTGRES_USER=spotlight
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=spotlight
DATABASE_URL=postgresql+psycopg://spotlight:CHANGE_ME_long_random_password@db:5432/spotlight
APP_ENV=development
SECRET_KEY=CHANGE_ME_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated desktop app origins
ALLOWED_ORIGINS=http://localhost:8000
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_RECOVERY=5/hour
RATE_LIMIT_COMMUNITY=10/minute
RATE_LIMIT_PROVIDER_REFRESH=1/minute
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up separately from the database; losing it makes saved provider keys unrecoverable.
PROVIDER_SECRETS_ENCRYPTION_KEY=
# Configure an SMTP relay before enabling online account recovery. Use port 587 with STARTTLS,
# or port 465 with SMTP_USE_SSL=true. Keep SMTP_PASSWORD private in the server's .env file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
# Used once when creating the first admin account; clear after use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
